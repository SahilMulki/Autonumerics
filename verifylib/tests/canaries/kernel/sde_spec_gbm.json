{
  "id": "canary_gbm",
  "equation_type": "SDE",
  "sde_family": "gbm",
  "state_dimension": 1,
  "noise_structure": "multiplicative",
  "equation": "dX = mu*X dt + sigma*X dW",
  "parameters": {
    "X_0": 1.0,
    "mu": 0.05,
    "sigma": 0.4
  },
  "time_interval": {
    "T0": 0.0,
    "T": 1.0
  },
  "drift_expression": "mu * X",
  "diffusion_expression": "sigma * X",
  "diffusion_derivative": "dg/dX = sigma  (g(X) = sigma*X)",
  "milstein_correction": "0.5 * g * dg/dX * (dW**2 - dt) = 0.5 * sigma**2 * X_n * (dW**2 - dt), at the PRE-step X_n",
  "milstein_eligible": true,
  "analytic_moments": {
    "has_analytic_solution": true,
    "state_dimension": 1,
    "mean_expression": "X_0 * np.exp(mu * t)",
    "variance_expression": "X_0**2 * np.exp(2*mu*t) * (np.exp(sigma**2 * t) - 1)"
  },
  "evaluation_thresholds": {
    "variance_rel_err_max": 0.1,
    "mean_rel_err_max": 0.05,
    "near_zero_mean_threshold": 0.01,
    "num_paths": 40000,
    "seed": 42,
    "dt": 0.002,
    "dt0": 0.02,
    "conv_levels": 3,
    "ci_mult": 2.0,
    "conv_num_paths": 20000,
    "stability_check": null
  },
  "verification": {
    "expected_provenance": "analytic",
    "expected_strong_order": 0.5,
    "expected_strong_order_milstein": 1.0,
    "expected_weak_order": 1.0,
    "terminal_law": {
      "law": "lognormal",
      "log_mean": "np.log(X_0) + (mu - sigma**2/2)*T",
      "log_variance": "sigma**2*T"
    },
    "dynkin_test_functions": [
      "X",
      "X**2"
    ],
    "constraints": [
      {
        "name": "finite",
        "expr": "np.isfinite(X)",
        "gate": true
      },
      {
        "name": "positivity",
        "expr": "X > 0",
        "gate": true
      }
    ],
    "moment_ode": {
      "state": [
        "m1",
        "m2"
      ],
      "rhs": [
        "mu*m1",
        "(2*mu + sigma**2)*m2"
      ],
      "initial": [
        "X_0",
        "X_0**2"
      ],
      "closes_exactly": true,
      "mean_from": "m1",
      "variance_from": "m2 - m1**2",
      "note": "GBM's moments close exactly: d/dt E[X] = mu E[X] and d/dt E[X^2] = (2mu + sigma^2) E[X^2]."
    }
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "equation",
      "quote": "dX = mu*X dt + sigma*X dW",
      "status": "mapped",
      "spec_path": "equation, parameters"
    }
  ]
}
