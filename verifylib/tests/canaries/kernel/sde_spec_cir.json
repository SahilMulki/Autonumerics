{
  "id": "canary_cir_feller_violated",
  "equation_type": "SDE",
  "sde_family": "cox_ingersoll_ross",
  "state_dimension": 1,
  "noise_dimension": 1,
  "noise_structure": "multiplicative",
  "equation": "dX = kappa*(theta - X)*dt + sigma*sqrt(X)*dW",
  "parameters": {
    "X_0": 0.5,
    "kappa": 1.0,
    "theta": 0.5,
    "sigma": 2.0
  },
  "time_interval": {
    "T0": 0.0,
    "T": 1.0
  },
  "drift_expression": "kappa * (theta - X)",
  "diffusion_expression": "sigma * np.sqrt(np.maximum(X, 0.0))",
  "analytic_moments": {
    "has_analytic_solution": true,
    "state_dimension": 1,
    "mean_expression": "theta + (X_0 - theta) * np.exp(-kappa * t)",
    "variance_expression": "(sigma**2 / kappa) * (X_0 * (np.exp(-kappa*t) - np.exp(-2*kappa*t)) + 0.5 * theta * (1 - np.exp(-kappa*t))**2)",
    "note": "Exact for any 2*kappa*theta vs sigma**2; the moment equations close regardless of the Feller condition. Copied from the live sde_cir_feller_violated spec, whose reference this kernel validates to ~1e-11 through the moment ODE."
  },
  "evaluation_thresholds": {
    "variance_rel_err_max": 0.1,
    "mean_rel_err_max": 0.05,
    "near_zero_mean_threshold": 0.01,
    "num_paths": 50000,
    "seed": 42,
    "dt": 0.005,
    "dt0": 0.02,
    "conv_levels": 3,
    "ci_mult": 2.0
  },
  "verification": {
    "expected_provenance": "analytic",
    "expected_strong_order": 0.5,
    "expected_weak_order": 1.0,
    "dynkin_test_functions": [
      "X",
      "np.tanh(X)"
    ],
    "moment_ode": {
      "state": ["m1", "m2"],
      "rhs": ["kappa*(theta - m1)", "2*kappa*theta*m1 - 2*kappa*m2 + sigma**2*m1"],
      "initial": ["X_0", "X_0**2"],
      "closes_exactly": true,
      "mean_from": "m1",
      "variance_from": "m2 - m1**2",
      "note": "Affine drift and g^2 = sigma^2*X affine in X, so both moments close exactly. Feller violation does not affect closure."
    },
    "constraints": [
      {
        "name": "positivity",
        "expr": "X >= 0",
        "gate": true
      },
      {
        "name": "finite",
        "expr": "np.isfinite(X)",
        "gate": true
      }
    ],
    "terminal_law": {
      "law": "noncentral_chi2",
      "scale": "sigma**2 * (1 - np.exp(-kappa*T)) / (4*kappa)",
      "df": "4*kappa*theta / sigma**2",
      "nc": "X_0 * np.exp(-kappa*T) / (sigma**2 * (1 - np.exp(-kappa*T)) / (4*kappa))",
      "note": "The exact CIR transition law. df = 0.5 < 2 is the Feller violation in the law's own terms: the chi-squared has fewer than two degrees of freedom, so the density diverges at the origin and zero is attainable."
    }
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "equation",
      "quote": "dX = kappa*(theta - X)*dt + sigma*sqrt(X)*dW",
      "status": "mapped",
      "spec_path": "equation, parameters"
    }
  ]
}
