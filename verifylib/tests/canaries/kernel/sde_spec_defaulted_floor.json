{
  "id": "canary_ou_no_declared_floor",
  "equation_type": "SDE",
  "sde_family": "ornstein_uhlenbeck",
  "state_dimension": 1,
  "noise_structure": "additive",
  "equation": "dX = theta*(mu - X)*dt + sigma*dW",
  "parameters": {
    "X_0": 2.0,
    "theta": 1.5,
    "mu": 0.0,
    "sigma": 0.5
  },
  "time_interval": {
    "T0": 0.0,
    "T": 1.0
  },
  "drift_expression": "theta * (mu - X)",
  "diffusion_expression": "sigma * np.ones_like(X)",
  "analytic_moments": {
    "has_analytic_solution": true,
    "state_dimension": 1,
    "mean_expression": "mu + (X_0 - mu) * np.exp(-theta * t)",
    "variance_expression": "sigma**2 / (2*theta) * (1 - np.exp(-2*theta*t))"
  },
  "evaluation_thresholds": {
    "variance_rel_err_max": 0.1,
    "mean_rel_err_max": 0.05,
    "near_zero_mean_threshold": 0.01,
    "num_paths": 50000,
    "seed": 42,
    "dt": 0.001,
    "dt0": 0.02,
    "conv_levels": 3,
    "ci_mult": 2.0
  },
  "verification": {
    "expected_provenance": "analytic",
    "expected_weak_order": 1.0,
    "dynkin_test_functions": [
      "X",
      "X**2"
    ],
    "moment_ode": {
      "state": [
        "m1",
        "m2"
      ],
      "rhs": [
        "theta*(mu - m1)",
        "2*theta*mu*m1 - 2*theta*m2 + sigma**2"
      ],
      "initial": [
        "X_0",
        "X_0**2"
      ],
      "closes_exactly": true,
      "mean_from": "m1",
      "variance_from": "m2 - m1**2"
    },
    "constraints": [
      {
        "name": "finite",
        "expr": "np.isfinite(X)",
        "gate": true
      }
    ],
    "note_on_the_missing_floor": "Deliberately absent, which is what 16 of the 23 SDE problems look like before Phase 6: the kernel then defaults to expected_strong_order 0.5. This process is additive-noise OU, where Euler-Maruyama has strong order 1, so a two-sided band around the default fails a correct solver at |0.986 - 0.5| = 0.486. D2's rule -- one-sided whenever the floor's source is kernel_default -- is what this spec exists to assert. schema.check_strong_order_declared flags this spec on purpose; the canary exercises the kernel's fallback, not the schema gate."
  },
  "requirements": [
    {
      "id": "R1",
      "kind": "equation",
      "quote": "dX = theta*(mu - X)*dt + sigma*dW",
      "status": "mapped",
      "spec_path": "equation, parameters"
    }
  ]
}
